datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  tournamentsCreated Tournament[] @relation("CreatedBy")
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  description String?
  format      String   // SINGLE_ELIMINATION | DOUBLE_ELIMINATION | ROUND_ROBIN
  status      String   @default("REGISTRATION")
  matchType   String   @default("S")
  scoreType   String   @default("RALLY")
  maxPlayers  Int      @default(16)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User     @relation("CreatedBy", fields: [createdById], references: [id])
  players   Player[]
  matches   Match[]
}

model Player {
  id           String   @id @default(cuid())
  tournamentId String
  firstName    String
  lastName     String
  duprId       String?
  seed         Int?
  checkedIn    Boolean  @default(false)
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Match {
  id                 String    @id
  tournamentId       String
  round              Int
  position           Int
  bracket            String    @default("WINNERS")
  player1Id          String?
  player2Id          String?
  game1P1            Int?
  game1P2            Int?
  game2P1            Int?
  game2P2            Int?
  game3P1            Int?
  game3P2            Int?
  game4P1            Int?
  game4P2            Int?
  game5P1            Int?
  game5P2            Int?
  winnerId           String?
  nextMatchId        String?
  nextMatchSlot      Int?
  loserNextMatchId   String?
  loserNextMatchSlot Int?
  isBye              Boolean   @default(false)
  courtNumber        Int?
  status             String    @default("SCHEDULED")
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  scoreHistory ScoreHistory[]

  @@unique([tournamentId, round, position, bracket])
}

model ScoreHistory {
  id           String   @id @default(cuid())
  matchId      String
  reporterName String
  reporterType String
  action       String
  scoreData    String
  createdAt    DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}
